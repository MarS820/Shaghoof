# Copy this file to .env and add your own API keys.
# Never commit a real key to GitHub.

# ── AI Tutor / Lesson / Quiz generation (Groq, used via langchain-groq) ──
# Without a GROQ key the tutor falls back to Gemini (below), then to a
# lesson-grounded offline mode.
GROQ_API_KEY=
# Optional model override (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# ── Gemini fallback (question generation, translation, evaluation) ──
GEMINI_API_KEY=

# ── Optional: AI video clips in generated lesson videos ──
# Uses LTX-Video (small, real-time text-to-video) via the Replicate API.
# When absent, the video player renders its built-in animated canvas scenes.
# REPLICATE_API_TOKEN=your_replicate_token_here

# Comma-separated browser origins permitted to call the API.
# FRONTEND_ORIGINS=http://localhost:5173,https://app.example.com
